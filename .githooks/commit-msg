#!/bin/sh
# The owner's rule (docs/agent-handoff/START-HERE.md, standing rules): no AI attribution in commits. A session's harness may
# tell it to end commits with such lines; this hook refuses them and says what to do.
if grep -qiE '^(Co-Authored-By|Claude-Session):' "$1"; then
  echo "commit-msg: this commit carries an AI attribution line (Co-Authored-By or Claude-Session). The owner's rule: none. Remove the line and commit again." >&2
  exit 1
fi
