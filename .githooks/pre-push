#!/bin/sh
# Blocks the push unless local CI passes. CI tests the working tree, so the tree must match what is committed.
# The CI runs only the passes this push can change (scripts/ci-plan.ts decides, from the files the push changes).
# git gives one line per ref on stdin: <local ref> <local sha> <remote ref> <remote sha>. A new branch, or a range
# that cannot be read, hands over no list, and then everything runs.
known=yes
seen=no
files=""
pushed=""
while read -r _local_ref local_sha remote_ref remote_sha; do
  [ -n "$local_sha" ] || continue   # an empty line is not a ref
  seen=yes
  case "$local_sha" in *[!0]*) ;; *) continue ;; esac   # a deleted ref pushes no files
  obj_type=$(git cat-file -t "$local_sha" 2>/dev/null || echo unknown)
  case "$remote_ref:$obj_type" in
    *:commit | refs/tags/*:tag) ;;
    *)
      echo "pre-push: $local_sha is a $obj_type, not a commit (cannot push to $remote_ref; push the commit id from git rev-parse HEAD)." >&2
      exit 1
      ;;
  esac
  if [ -z "$pushed" ] || [ "$pushed" = "$local_sha" ]; then pushed="$local_sha"; else pushed=many; fi
  [ "$known" = yes ] || continue
  case "$remote_sha" in *[!0]*) ;; *) known=no; continue ;; esac   # a new branch: no range to read
  range=$(git diff --name-only "$remote_sha" "$local_sha" 2>/dev/null) || { known=no; continue; }
  files="$files
$range"
done

if [ -n "$(git status --porcelain)" ]; then
  echo "pre-push: uncommitted or untracked files. CI tests the working tree, so commit or remove them first." >&2
  exit 1
fi

if [ "$seen" = yes ] && [ "$known" = yes ]; then
  CI_CHANGED="$files"
  export CI_CHANGED
else
  unset CI_CHANGED
fi
# The tree a green run on the public repository is compared with is the pushed commit's, not the checkout's.
if [ -n "$pushed" ]; then CI_PUSHED="$pushed"; export CI_PUSHED; else unset CI_PUSHED; fi
# A cloud box ships its own Chrome and not the browser Playwright installs, so a push with E2E_CHROMIUM unset failed
# every lag test at launch (Nov 22). The hook names the box's browser itself when it is there and none was named.
if [ -z "$E2E_CHROMIUM" ] && [ -x /opt/google/chrome/chrome ]; then
  E2E_CHROMIUM=/opt/google/chrome/chrome
  export E2E_CHROMIUM
  echo "pre-push: E2E_CHROMIUM was not set; using /opt/google/chrome/chrome." >&2
fi
exec bun run ci
